PORT=8080
SMS_PROVIDER=msg91
COOLDOWN_SECONDS=60
MAX_SENDS_PER_HOUR=5

# MSG91 (DLT Transactional Flow for Login Success Notification)
MSG91_AUTHKEY=
MSG91_LOGIN_TEMPLATE_ID=
MSG91_SENDER_ID=AGRIVS

# Fast2SMS (Quick / Transactional SMS)
# SMS_PROVIDER=fast2sms
# FAST2SMS_API_KEY=

# Optional shared secret to prevent unauthenticated arbitrary calls
LOGIN_NOTIFY_SECRET=

# Optional alternative: 2Factor
# SMS_PROVIDER=2factor
# TWOFACTOR_API_KEY=
# TWOFACTOR_SENDER_ID=AGRIVS
